# ------------------------------------------------------------------
# Dream by Moaz — environment variables
# Copy this file to `.env.local` and fill in your real values.
# `.env.local` is gitignored; this file is the committed template.
# ------------------------------------------------------------------

# MongoDB connection string — used by /api/blog and /api/gallery
# Example: mongodb+srv://<user>:<password>@cluster.mongodb.net/<db>
MONGODB_URI=

# Resend API key — used by /api/send for the contact-form emails
# Get one at https://resend.com/api-keys
RESEND_API_KEY=

# Public API base URL (prefix for client-side fetches).
# Points at this same app in production; use http://localhost:3000 in local dev.
NEXT_PUBLIC_API_ENDPOINT=https://www.dreambymoaz.com
